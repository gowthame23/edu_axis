{
  "name": "eduaxis",
  "version": "1.0.0",
  "description": "EduAxis - Comprehensive School Management System",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix Backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run start:backend\" \"npm run dev:frontend\"",
    "start:backend": "npm --prefix Backend start",
    "build": "npm --prefix Backend install && npm --prefix frontend install --include=dev && npm --prefix frontend run build",
    "start:prod": "cd Backend && node server.js",
    "install:all": "npm install && npm --prefix Backend install && npm --prefix frontend install"
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  }
}
