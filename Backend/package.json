{
  "name": "eduaxis-backend",
  "version": "1.0.0",
  "description": "Backend API for EduAxis School Management System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "perf:phase1": "node scripts/phase1PerfReport.js",
    "solr:reindex": "node scripts/solrReindex.js",
    "test": "vitest run",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile=test-reports/backend-test-report.json"
  },
  "keywords": [
    "school",
    "management",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "razorpay": "^2.9.4",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1",
    "solr-node": "^1.0.8",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "vitest": "^3.2.4"
  }
}
