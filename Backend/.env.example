# EduAxis Backend - Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=your-mongodb-connection-string-here

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# CSRF Configuration
CSRF_SECRET=your-csrf-secret-change-in-production

# Logging
LOG_LEVEL=info

# B2B Partner API Authentication
# Option 1: single key
B2B_API_KEY=eduaxis-partner-dev-key
# Option 2: comma-separated keys (recommended for multiple partners)
B2B_API_KEYS=partner-a-key,partner-b-key

# External APIs used by Phase 2 integrations
# Public holidays provider (default is nager.at if left blank)
EXTERNAL_HOLIDAY_API_BASE=https://date.nager.at/api/v3/PublicHolidays
# Exchange rates provider (default is frankfurter.app if left blank)
EXTERNAL_EXCHANGE_API_BASE=https://api.frankfurter.app/latest
# Holiday endpoint has a built-in fallback list if the provider returns empty/non-JSON

# Query Profiling
ENABLE_DB_PROFILING=true
SLOW_QUERY_MS=150

# Redis Cache
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379

# Solr Search
SOLR_ENABLED=false
SOLR_PROTOCOL=http
SOLR_HOST=127.0.0.1
SOLR_PORT=8983
SOLR_CORE=eduaxis
